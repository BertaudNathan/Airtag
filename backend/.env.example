# Backend Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL (for events)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=airtag
PG_USER=airtag_user
PG_PASSWORD=airtag_pass

# InfluxDB (for hardware metrics time-series)
INFLUX_HOST=localhost
INFLUX_PORT=8086
INFLUX_DATABASE=airtag_metrics
INFLUX_USER=airtag
INFLUX_PASSWORD=airtag_pass

# Server
LOG_LEVEL=debug
CORS_ORIGIN=*
MAX_REQUEST_SIZE=1mb

# Data retention
HARDWARE_RETENTION_DAYS=30
